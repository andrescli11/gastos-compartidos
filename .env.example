# Solo servidor. No habilita persistencia por sí mismo.
APP_URL=http://localhost:3000
# Login PostgreSQL de mínimo privilegio; no usar postgres/service_role.
DATABASE_URL=

# Generar aleatoriamente al menos 32 bytes; nunca exponer como NEXT_PUBLIC_.
RATE_LIMIT_SECRET=

# Certificado raíz PEM del proveedor si no pertenece al trust store de Node.
# Mantener la validación TLS activa; configurar PEM completo en Vercel.
DATABASE_CA_CERT=
